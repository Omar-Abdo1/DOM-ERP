# Normalize line endings: LF in repo, native on checkout
* text=auto eol=lf

# Source / config files — always LF in repo
*.cs             text diff=csharp
*.csproj         text
*.json           text
*.md             text
*.xml            text
*.config         text
*.yml            text
*.yaml           text
.gitignore       text
.gitattributes   text

# Visual Studio solution — Windows-only tool, keep CRLF
*.sln            text eol=crlf
*.slnx           text eol=crlf

# Binary — never touch
*.png            binary
*.jpg            binary
*.jpeg           binary
*.gif            binary
*.ico            binary
*.pdf            binary
*.zip            binary
